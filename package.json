{
  "name": "rel-parser",
  "version": "2.0.1",
  "description": "A simple function to scrape rel links from a url or html document",
  "type": "module",
  "main": "dist/main.cjs",
  "module": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "require": "./dist/main.cjs",
      "import": "./dist/main.js",
      "types": "./dist/main.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "fix": "biome check --write src",
    "clean:test": "rm -rf tmp/tests",
    "test": "npm run clean:test && npm run test:lint && npm run test:build && npm run test:unit",
    "test:build": "tsup --env.TEST=yes",
    "test:lint": "biome check src",
    "test:unit": "ava"
  },
  "license": "MIT",
  "files": [
    "dist/**/*",
    "CHANGELOG.md",
    "README.md"
  ],
  "homepage": "https://github.com/grantcodes/rel-parser#readme",
  "engines": {
    "node": ">=22.20.0"
  },
  "bugs": {
    "url": "https://github.com/grantcodes/rel-parser",
    "email": "mail@grant.codes"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grantcodes/rel-parser.git"
  },
  "author": {
    "url": "https://grant.codes",
    "name": "Grant Richmond",
    "email": "mail@grant.codes"
  },
  "dependencies": {
    "htmlparser2": "^12.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@grantcodes/commit": "^2.0.0",
    "ava": "^8.1.2",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3"
  },
  "ava": {
    "files": [
      "tmp/tests/tests/**/*",
      "!tmp/tests/tests/data"
    ]
  }
}
